{
  "name": "cardnews-generator",
  "version": "1.0.0",
  "description": "Instagram card news generator Figma plugin",
  "private": true,
  "scripts": {
    "build:code": "esbuild src/plugin/code.ts --bundle --target=es2020 --outfile=dist/code.js",
    "build:ui": "vite build",
    "build": "npm run build:code && npm run build:ui",
    "dev": "concurrently -n code,ui \"npm run build:code -- --watch\" \"vite build --watch\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/plugin/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}